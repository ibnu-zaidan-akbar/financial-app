// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  tabungan      Tabungan[]
  transaksi     Transaksi[]
  
  @@map("users")
}

model Kategori {
  id        String   @id @default(cuid())
  nama      String
  jenis     String
  icon      String?
  warna     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  transaksi Transaksi[]
  
  @@unique([nama, jenis])
  @@map("kategori")
}

model Transaksi {
  id               String    @id @default(cuid())
  judul            String
  jumlah           Float
  deskripsi        String?
  tanggal          DateTime
  tipe             String
  kategoriId       String?
  tabunganId       String?
  tabunganTujuanId String?
  biayaAdmin       Float?    @default(0)
  userId           String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  kategori       Kategori? @relation(fields: [kategoriId], references: [id])
  tabungan       Tabungan? @relation("TabunganAsal", fields: [tabunganId], references: [id])
  tabunganTujuan Tabungan? @relation("TabunganTujuan", fields: [tabunganTujuanId], references: [id])
  user           User      @relation(fields: [userId], references: [id])
  
  @@map("transaksi")
}

model Tabungan {
  id        String    @id @default(cuid())
  nama      String
  saldoAwal Float     @default(0)
  jumlah    Float     @default(0)
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  transaksiAsal   Transaksi[] @relation("TabunganAsal")
  transaksiTujuan Transaksi[] @relation("TabunganTujuan")
  user            User        @relation(fields: [userId], references: [id])
  
  @@map("tabungan")
}

model Anggaran {
  id        String    @id @default(cuid())
  kategori  String
  jumlah    Float
  periode   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@map("anggaran")
}